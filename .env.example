# Two different login codes. Each must be EXACTLY 10 characters (letters, numbers or a mix, no spaces).
# Example format only: Ab12Cd34Ef
CODE_A=ChangeMeA1
CODE_B=ChangeMeB2
NAME_A=Manish
NAME_B=Friend

# Long random string (32+ characters) used to sign the session cookie
SESSION_SECRET=put-a-long-random-string-here

# Added automatically when you connect Vercel Marketplace > Upstash Redis
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Added automatically when you create a Vercel Storage > Blob store
# BLOB_READ_WRITE_TOKEN=

# Optional: TURN server so calls connect on every network
# TURN_URL=turn:example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# REQUIRED in production: the daily cleanup route stays closed (503) without it. Vercel Cron sends it automatically.
CRON_SECRET=put-another-long-random-string-here

# Optional: how many days text and call messages are kept (default 7, 0 = keep until the 300-message limit)
# MESSAGE_TTL_DAYS=7

# Voice typing (speech-to-text). REQUIRED for reliable Hindi + English (Hinglish) dictation.
# Without it the app falls back to the browser's built-in recognition (one language at a time, less accurate).
# Any OpenAI-compatible transcription API works. The key stays on the server (Vercel Environment Variables).
# STT_API_KEY=
# STT_MODEL=gpt-4o-transcribe
# STT_API_URL=https://api.openai.com/v1/audio/transcriptions
